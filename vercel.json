{
  "version": 2,
  "builds": [
    { "src": "api/config.js", "use": "@vercel/node" },
    { "src": "api/proxy.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/proxy", "dest": "/api/proxy.js" },
    { "src": "/api/proxy/(.*)", "dest": "/api/proxy.js" }
  ]
}
