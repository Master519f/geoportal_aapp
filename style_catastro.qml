&lt;table border ="1" cellpadding="1" cellspacing="1">&#xd;
&#xd;
&#xd;
&lt;tr bgcolor="#a6cee3" >&#xd;
&lt;th> Agua Potable&lt;/th>&#xd;
&lt;th>Catastro Predial&lt;/th>&#xd;
&lt;/tr>&#xd;
&lt;tr>&#xd;
&lt;td>&#xd;
&lt;b>Cliente: &lt;/b> [% "nombres" %]&#xd;
