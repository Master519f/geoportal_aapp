    <actionsetting icon="" notificationMessage="" name="Generar Notificación PDF" capture="1" id="{a99f2fbc-f5ea-465f-8b88-e9bfa4f4aa6d}" type="1" action="import os&#xd;&#xa;import datetime&#xd;&#xa;from reportlab.lib.pagesizes import A4&#xd;&#xa;from reportlab.lib import colors&#xd;&#xa;from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer&#xd;&#xa;from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle&#xd;&#xa;from reportlab.pdfgen import canvas&#xd;&#xa;from qgis.core import QgsMessageLog, Qgis&#xd;&#xa;&#xd;&#xa;# Mensaje de inicio&#xd;&#xa;QgsMessageLog.logMessage(&quot;=== INICIO DEL SCRIPT DE GENERACIÓN DE PDF ===&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;&#xd;&#xa;# --- DICCIONARIOS DE CONVERSIÓN ---&#xd;&#xa;&#xd;&#xa;# Diámetro de conexión&#xd;&#xa;diametro_map = {&#xd;&#xa;    '01': '1/2&quot;',&#xd;&#xa;    '02': '3/4&quot;',&#xd;&#xa;    '03': '1&quot;',&#xd;&#xa;    '04': '1 1/2&quot;',&#xd;&#xa;    '05': '2&quot;',&#xd;&#xa;    '07': '1&quot; a 2&quot;'&#xd;&#xa;}&#xd;&#xa;&#xd;&#xa;# Tipo de Conexión&#xd;&#xa;tipo_conexion_map = {&#xd;&#xa;    '00': 'No tienen',&#xd;&#xa;    '01': 'Con Micromedicion',&#xd;&#xa;    '02': 'Tarifa Fija',&#xd;&#xa;    '03': 'Cierre Provisional',&#xd;&#xa;    '04': 'Consumidor no medido',&#xd;&#xa;    '05': 'Cierre definitivo'&#xd;&#xa;}&#xd;&#xa;&#xd;&#xa;# Categoría de servicio&#xd;&#xa;categoria_servicio_map = {&#xd;&#xa;    '01': '01. Residencial (R)',&#xd;&#xa;    '02': '02. No Residencial-Comercial (NR-C)',&#xd;&#xa;    '03': '03. No Residencial-Industrial (NR-I)',&#xd;&#xa;    '05': '05. No Residencial-Publico (NR-P)'&#xd;&#xa;}&#xd;&#xa;&#xd;&#xa;# Tipo de Exoneración&#xd;&#xa;tipo_exoneracion_map = {&#xd;&#xa;    '00': 'Ninguna',&#xd;&#xa;    '01': 'TERCERA EDAD',&#xd;&#xa;    '02': 'DISCAPACIDAD',&#xd;&#xa;    '03': 'TERCERA EDAD - CONYUGE SOBREVIVIENTE'&#xd;&#xa;}&#xd;&#xa;&#xd;&#xa;# Tipo Abastecimiento&#xd;&#xa;tipo_abastecimiento_map = {&#xd;&#xa;    '00': 'NO TIENE',&#xd;&#xa;    '01': 'RED PUBLICA',&#xd;&#xa;    '02': 'POZO',&#xd;&#xa;    '03': 'TANQUERO',&#xd;&#xa;    '04': 'ALJIBE',&#xd;&#xa;    '05': 'OTRAS FUENTES'&#xd;&#xa;}&#xd;&#xa;&#xd;&#xa;# --- MAPEO DE DATOS ---&#xd;&#xa;try:&#xd;&#xa;    # Obtener valores crudos&#xd;&#xa;    diametro_raw = u'[% &quot;ag01diameagua&quot; %]'&#xd;&#xa;    tipo_conexion_raw = u'[% &quot;ag01dispon&quot; %]'&#xd;&#xa;    categoria_servicio_raw = u'[% &quot;ag01tarifa&quot; %]'&#xd;&#xa;    tipo_exoneracion_raw = u'[% &quot;ag01tipoexoner&quot; %]'  &#xd;&#xa;    tipo_abastecimiento_raw = u'[% &quot;ag01tipoabaste&quot; %]'  &#xd;&#xa;    &#xd;&#xa;    # Convertir valores&#xd;&#xa;    diametro_convertido = diametro_map.get(diametro_raw, diametro_raw)&#xd;&#xa;    tipo_conexion_convertido = tipo_conexion_map.get(tipo_conexion_raw, tipo_conexion_raw)&#xd;&#xa;    categoria_servicio_convertido = categoria_servicio_map.get(categoria_servicio_raw, categoria_servicio_raw)&#xd;&#xa;    tipo_exoneracion_convertido = tipo_exoneracion_map.get(tipo_exoneracion_raw, tipo_exoneracion_raw)&#xd;&#xa;    tipo_abastecimiento_convertido = tipo_abastecimiento_map.get(tipo_abastecimiento_raw, tipo_abastecimiento_raw)&#xd;&#xa;    &#xd;&#xa;    data = {&#xd;&#xa;        'cliente': u'[% &quot;nombres&quot; %]',&#xd;&#xa;        'cedula': u'[% &quot;ruc_cedula&quot; %]',&#xd;&#xa;        'suministro': u'[% &quot;cod_client&quot; %]',&#xd;&#xa;        'clave_aapp': u'[% &quot;clave_ag&quot; %]',&#xd;&#xa;        'direccion': u'[% &quot;direccion&quot; %]',&#xd;&#xa;        'diametro': diametro_convertido,&#xd;&#xa;        'tipo_conexion': tipo_conexion_convertido,&#xd;&#xa;        'categoria_servicio': categoria_servicio_convertido,&#xd;&#xa;        'tipo_exoneracion': tipo_exoneracion_convertido,&#xd;&#xa;        'tipo_abastecimiento': tipo_abastecimiento_convertido,&#xd;&#xa;        'contribuyente': u'[% &quot;nombres&quot; %]',&#xd;&#xa;        'id_predio': u'[% &quot;id&quot; %]',&#xd;&#xa;        'clave_predial': u'[% &quot;predio_mun&quot; %]',&#xd;&#xa;    }&#xd;&#xa;    &#xd;&#xa;    QgsMessageLog.logMessage(&quot;Datos mapeados correctamente&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;  Diámetro: {diametro_raw} -> {diametro_convertido}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;  Tipo Conexión: {tipo_conexion_raw} -> {tipo_conexion_convertido}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;  Categoría Servicio: {categoria_servicio_raw} -> {categoria_servicio_convertido}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;  Tipo Exoneración: {tipo_exoneracion_raw} -> {tipo_exoneracion_convertido}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;  Tipo Abastecimiento: {tipo_abastecimiento_raw} -> {tipo_abastecimiento_convertido}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    &#xd;&#xa;except Exception as e:&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;Error en mapeo de datos: {str(e)}&quot;, &quot;EPMAPAQ&quot;, Qgis.Critical)&#xd;&#xa;&#xd;&#xa;def generar_reporte_epmanpaq():&#xd;&#xa;    try:&#xd;&#xa;        QgsMessageLog.logMessage(&quot;=== GENERANDO REPORTE ===&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        &#xd;&#xa;        # Verificar que data contiene valores válidos&#xd;&#xa;        QgsMessageLog.logMessage(f&quot;ID Predio: {data.get('id_predio', 'NO DISPONIBLE')}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        QgsMessageLog.logMessage(f&quot;Cliente: {data.get('cliente', 'NO DISPONIBLE')}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        &#xd;&#xa;        # Ruta de la imagen de fondo (UNIDAD D:)&#xd;&#xa;        #fondo_path = r&quot;D:\epmapaq_background.png&quot;&#xd;&#xa;        fondo_path = r&quot;D:\COMERCIALIZACION\EPMAPAQ_GIS_DATA\LOGOS\epmapaq_background.png&quot;&#xd;&#xa;        # Verificar si existe el archivo de fondo&#xd;&#xa;        if os.path.exists(fondo_path):&#xd;&#xa;            QgsMessageLog.logMessage(f&quot;✓ Fondo encontrado: {fondo_path}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        else:&#xd;&#xa;            QgsMessageLog.logMessage(f&quot;✗ ADVERTENCIA: No se encuentra el fondo en {fondo_path}&quot;, &quot;EPMAPAQ&quot;, Qgis.Warning)&#xd;&#xa;        &#xd;&#xa;        # 1. Definir ruta de salida&#xd;&#xa;        output_dir = r&quot;D:\COMERCIALIZACION\EPMAPAQ_GIS_DATA\reports\notific&quot;&#xd;&#xa;        &#xd;&#xa;        # Crear el directorio si no existe&#xd;&#xa;        if not os.path.exists(output_dir):&#xd;&#xa;            os.makedirs(output_dir)&#xd;&#xa;            QgsMessageLog.logMessage(f&quot;Directorio creado: {output_dir}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        &#xd;&#xa;        safe_id = str(data['id_predio']).replace(&quot;/&quot;, &quot;-&quot;).replace(&quot;\\&quot;, &quot;-&quot;)&#xd;&#xa;        filename = f&quot;Notificacion_{safe_id}.pdf&quot;&#xd;&#xa;        output_path = os.path.join(output_dir, filename)&#xd;&#xa;        QgsMessageLog.logMessage(f&quot;Ruta de salida: {output_path}&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        &#xd;&#xa;        # 2. Configurar PDF&#xd;&#xa;        doc = SimpleDocTemplate(output_path, &#xd;&#xa;                               pagesize=A4,&#xd;&#xa;                               leftMargin=50, &#xd;&#xa;                               rightMargin=50, &#xd;&#xa;                               topMargin=50, &#xd;&#xa;                               bottomMargin=50)&#xd;&#xa;        &#xd;&#xa;        styles = getSampleStyleSheet()&#xd;&#xa;        elements = []&#xd;&#xa;        &#xd;&#xa;        # Estilos personalizados&#xd;&#xa;        blue_header = ParagraphStyle('Header', parent=styles['Normal'], &#xd;&#xa;                                    fontSize=10, textColor=colors.white, &#xd;&#xa;                                    alignment=1, fontName='Helvetica-Bold')&#xd;&#xa;        row_style = ParagraphStyle('Row', parent=styles['Normal'], fontSize=9)&#xd;&#xa;        &#xd;&#xa;        # 3. Encabezado y Fecha&#xd;&#xa;        anio_actual = datetime.datetime.now().year&#xd;&#xa;        numero_id = data['id_predio']&#xd;&#xa;        fecha = datetime.datetime.now().strftime(f&quot;%d de mayo de {anio_actual}&quot;)&#xd;&#xa;        &#xd;&#xa;        # Línea modificada con año dinámico y número ID&#xd;&#xa;        elements.append(Paragraph(f&quot;&lt;b>Notificación No. EPMAPAQ-SGC-DC-{anio_actual}-{numero_id}&lt;/b>&quot;, ParagraphStyle('R', parent=styles['Normal'], alignment=2)))&#xd;&#xa;        elements.append(Paragraph(f&quot;Quevedo, {fecha}&quot;, ParagraphStyle('R', parent=styles['Normal'], alignment=2)))&#xd;&#xa;        elements.append(Spacer(1, 20))&#xd;&#xa;        elements.append(Paragraph(&quot;&lt;b>Señor/Señora&lt;/b>&quot;, styles['Normal']))&#xd;&#xa;        elements.append(Paragraph(f&quot;{data['cliente']}&quot;, styles['Normal']))&#xd;&#xa;        elements.append(Spacer(1, 10))&#xd;&#xa;                &#xd;&#xa;        # 4. Texto introductorio&#xd;&#xa;        txt_intro = (&quot;El presente es para informarle que en aplicación de la ORDENANZA QUE REGULA LAS CONDICIONES DE LAS TARIFAS POR LA PRESTACIÓN DE LOS SERVICIOS PÚBLICOS DE AGUA POTABLE Y SANEAMIENTO AMBIENTAL RELACIONADOS CON EL AGUA EN EL CANTÓN QUEVEDO, La EPMAPAQ procederá a realizar una inspección técnica, instalación de micro medidor del suministro que se detalla a continuacion:&quot;)&#xd;&#xa;        elements.append(Paragraph(txt_intro, ParagraphStyle('J', parent=styles['Normal'], alignment=4)))&#xd;&#xa;        elements.append(Spacer(1, 15))&#xd;&#xa;        &#xd;&#xa;        # 5. Tabla Catastro Comercial (CON TODOS LOS NUEVOS CAMPOS)&#xd;&#xa;        data_table1 = [&#xd;&#xa;            [Paragraph(&quot;&lt;b>Catastro Comercial de Usuarios EPMAPAQ&lt;/b>&quot;, blue_header)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Cliente:&lt;/b> {data['cliente']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Cédula/RUC:&lt;/b> {data['cedula']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Suministro:&lt;/b> {data['suministro']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Clave AA.PP:&lt;/b> {data['clave_aapp']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Dirección:&lt;/b> {data['direccion']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Diámetro de Conexión:&lt;/b> {data['diametro']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Tipo de Conexión:&lt;/b> {data['tipo_conexion']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Categoría de Servicio:&lt;/b> {data['categoria_servicio']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Tipo de Exoneración:&lt;/b> {data['tipo_exoneracion']}&quot;, row_style)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Tipo de Abastecimiento:&lt;/b> {data['tipo_abastecimiento']}&quot;, row_style)],&#xd;&#xa;        ]&#xd;&#xa;        t1 = Table(data_table1, colWidths=[450])&#xd;&#xa;        t1.setStyle(TableStyle([&#xd;&#xa;            ('BACKGROUND', (0,0), (-1,0), colors.dodgerblue),&#xd;&#xa;            ('GRID', (0,0), (-1,-1), 0.5, colors.black),&#xd;&#xa;            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),&#xd;&#xa;            ('PADDING', (0,0), (-1,-1), 6),&#xd;&#xa;        ]))&#xd;&#xa;        elements.append(t1)&#xd;&#xa;        elements.append(Spacer(1, 15))&#xd;&#xa;        &#xd;&#xa;        # 6. Tabla Catastro Predial&#xd;&#xa;        data_table2 = [&#xd;&#xa;            [Paragraph(&quot;&lt;b>Catastro Predial Municipal&lt;/b>&quot;, blue_header)],&#xd;&#xa;            [Paragraph(f&quot;&lt;b>Contribuyente:&lt;/b> {data['contribuyente']}&quot;, row_style)],          &#xd;&#xa;            [Paragraph(f&quot;&lt;b>Clave Predial:&lt;/b> {data['clave_predial']}&quot;, row_style)],          &#xd;&#xa;        ]&#xd;&#xa;        t2 = Table(data_table2, colWidths=[450])&#xd;&#xa;        t2.setStyle(TableStyle([&#xd;&#xa;            ('BACKGROUND', (0,0), (-1,0), colors.dodgerblue),&#xd;&#xa;            ('GRID', (0,0), (-1,-1), 0.5, colors.black),&#xd;&#xa;            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),&#xd;&#xa;            ('PADDING', (0,0), (-1,-1), 6),&#xd;&#xa;        ]))&#xd;&#xa;        elements.append(t2)&#xd;&#xa;        &#xd;&#xa;        # 7. Texto adicional&#xd;&#xa;        elements.append(Spacer(1, 20))&#xd;&#xa;        texto_final = (&quot;Adicionalmente, conforme a lo dispuesto en la Ordenanza antes referida, se sirva remitir los documentos del representante legal, de ser el caso, indicando además correo electrónico y numero de contacto personal y/o institucional, al e-mail: comercializacion@epmapaq.gob.ec&quot;)&#xd;&#xa;        elements.append(Paragraph(texto_final, ParagraphStyle('J', parent=styles['Normal'], alignment=4)))&#xd;&#xa;        &#xd;&#xa;        # 8. Firma&#xd;&#xa;        elements.append(Spacer(1, 30))&#xd;&#xa;        elements.append(Paragraph(&quot;Atentamente,&quot;, styles['Normal']))&#xd;&#xa;        elements.append(Spacer(1, 40))&#xd;&#xa;        elements.append(Paragraph(&quot;Ing. Diego Cruz Zambrano&quot;, styles['Normal']))        &#xd;&#xa;        elements.append(Paragraph(&quot;&lt;b>SUBGERENCIA DE COMERCIALIZACIÓN&lt;/b>&quot;, styles['Normal']))&#xd;&#xa;        #elements.append(Paragraph(&quot;EMPRESA PÚBLICA MUNICIPAL DE AGUA POTABLE Y ALCANTARILLADO DE QUEVEDO&quot;, &#xd;&#xa;        #                         ParagraphStyle('Footer', parent=styles['Normal'], fontSize=8, alignment=1)))&#xd;&#xa;        &#xd;&#xa;        # 9. Función para agregar fondo&#xd;&#xa;        def add_background(canvas_obj, doc_obj):&#xd;&#xa;            &quot;&quot;&quot;Agrega la imagen de fondo al PDF&quot;&quot;&quot;&#xd;&#xa;            canvas_obj.saveState()&#xd;&#xa;            if os.path.exists(fondo_path):&#xd;&#xa;                try:&#xd;&#xa;                    # Dibujar imagen de fondo en toda la página&#xd;&#xa;                    canvas_obj.drawImage(fondo_path, 0, 0, &#xd;&#xa;                                       width=A4[0], &#xd;&#xa;                                       height=A4[1],&#xd;&#xa;                                       preserveAspectRatio=False,&#xd;&#xa;                                       mask='auto')&#xd;&#xa;                except Exception as e:&#xd;&#xa;                    QgsMessageLog.logMessage(f&quot;Error al dibujar fondo: {str(e)}&quot;, &quot;EPMAPAQ&quot;, Qgis.Warning)&#xd;&#xa;            canvas_obj.restoreState()&#xd;&#xa;        &#xd;&#xa;        # 10. Generar PDF con fondo&#xd;&#xa;        QgsMessageLog.logMessage(&quot;Construyendo PDF...&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;        doc.build(elements, onFirstPage=add_background, onLaterPages=add_background)&#xd;&#xa;        &#xd;&#xa;        # 11. Verificar que el PDF se creó y abrirlo&#xd;&#xa;        if os.path.exists(output_path):&#xd;&#xa;            os.startfile(output_path)&#xd;&#xa;            QgsMessageLog.logMessage(f&quot;✓ PDF generado exitosamente en: {output_path}&quot;, &quot;EPMAPAQ&quot;, Qgis.Success)&#xd;&#xa;        else:&#xd;&#xa;            QgsMessageLog.logMessage(f&quot;✗ El PDF no se creó correctamente&quot;, &quot;EPMAPAQ&quot;, Qgis.Critical)&#xd;&#xa;        &#xd;&#xa;    except Exception as e:&#xd;&#xa;        QgsMessageLog.logMessage(f&quot;✗ ERROR al generar PDF: {str(e)}&quot;, &quot;EPMAPAQ&quot;, Qgis.Critical)&#xd;&#xa;        import traceback&#xd;&#xa;        QgsMessageLog.logMessage(traceback.format_exc(), &quot;EPMAPAQ&quot;, Qgis.Critical)&#xd;&#xa;&#xd;&#xa;# Ejecutar la función&#xd;&#xa;try:&#xd;&#xa;    QgsMessageLog.logMessage(&quot;=== EJECUTANDO FUNCIÓN PRINCIPAL ===&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;    generar_reporte_epmanpaq()&#xd;&#xa;    QgsMessageLog.logMessage(&quot;=== FIN DEL SCRIPT ===&quot;, &quot;EPMAPAQ&quot;, Qgis.Info)&#xd;&#xa;except Exception as e:&#xd;&#xa;    QgsMessageLog.logMessage(f&quot;✗ Error fatal: {str(e)}&quot;, &quot;EPMAPAQ&quot;, Qgis.Critical)" isEnabledOnlyWhenEditable="0" shortTitle="Notificación Inst. Medidor">
