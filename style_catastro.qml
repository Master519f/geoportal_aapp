&lt;b>Categoria: &lt;/b> [% if("ag01tarifa" IS NULL,'',if("ag01tarifa"='01','Residencial',if("ag01tarifa"='02','NR-Comercial',if("ag01tarifa"='03','NR-Industrial',if("ag01tarifa"='05','NR-Público',''))))) %]&#xd;
&lt;br>&#xd;
&lt;b>Abastecimiento: &lt;/b> [% CASE WHEN  "ag01tipoabaste" = '00' THEN 'NO TIENE' WHEN "ag01tipoabaste" = '01' THEN 'RED PUBLICA' WHEN "ag01tipoabaste" = '02' THEN 'POZO' END %]&#xd;
&lt;br>&#xd;
&lt;b>Diámetro Conex: &lt;/b> [% CASE &#xd;
WHEN "ag01diameagua" = '00' THEN 'Sin dato' &#xd;
WHEN "ag01diameagua" = '01' THEN '1/2"' &#xd;
WHEN "ag01diameagua" = '02' THEN '3/4"' &#xd;
WHEN "ag01diameagua" = '03' THEN '1"'&#xd;
WHEN "ag01diameagua" = '04' THEN '1 1/2"'&#xd;
WHEN "ag01diameagua" = '05' THEN '2"'&#xd;
WHEN "ag01diameagua" = '07' THEN '1" a 2"'&#xd;
WHEN "ag01diameagua" = '08' THEN '2" a 4”'&#xd;
END %]&#xd;
&lt;br>&#xd;
&lt;b>Dispone AA.SS.: &lt;/b> [% IF(("ag01alcadi"IS NULL),'',IF("ag01alcadi"='01','Si tiene','No tiene')) %]&#xd;
&lt;br>&#xd;
&lt;b>Tarifa AP: &lt;/b> [% "tarifa_ag" %] &#xd;
&lt;br>&#xd;
&lt;br>&#xd;
&lt;b>Deuda: $&lt;/b> &lt;span style="color: red; font-weight: bold;">[% format_number ("total_deud",places:=2) %]&lt;/span>&#xd;
&lt;b> por &lt;/b> &lt;span style="color: red; font-weight: bold;">[% "deuda_mese" %]&lt;/span> planillas acum.&#xd;
&lt;br>&#xd;
&lt;br>&#xd;
&lt;b>Estado Servicio: &lt;/b> [% CASE &#xd;
WHEN "ag01esta" = 'AC' THEN 'EN SERVICIO' &#xd;
WHEN "ag01esta" = 'CO' THEN 'CORTADO"' &#xd;
WHEN "ag01esta" = 'CE' THEN 'BLOQUEADO"' &#xd;
END %]&#xd;
&lt;br>&#xd;
&lt;br>&#xd;
&lt;b>Zona de cobertura de AA-SS?: &lt;/b> &lt;span style="color: green; font-weight: bold;">[%aggregate(&#xd;
  layer:='AASS Cobertura',&#xd;
  aggregate:='concatenate',&#xd;
  expression:="alcanta",&#xd;
  filter:=intersects($geometry, geometry(@parent))&#xd;
)%]&lt;/span>&#xd;
&lt;br>&#xd;
